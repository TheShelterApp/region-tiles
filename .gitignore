node_modules/

# Read-only source snapshot + downloads (reproducible from NeoFeoda cache + Natural Earth).
# Not committed: large, and regenerated by `npm run stage`.
src-data/

# Intermediate build artifacts (normalized, pre-simplification).
.build/

# Large distributable artifacts (SQLite bundle) — published as a GitHub Release.
dist/

# OS noise
.DS_Store

# Raw USGS ComCat pages of the area-history statistics (pipeline/stats): re-downloadable, never committed.
.cache/

# The place-names pack's local builds, staged sources and Wikidata cache (places/README.md) are under dist/ above. Release
# bytes live under places/dist/<version>/ and are committed by a release PR: the dist/ rule must not hide them (a release
# PR without them would let the tag point at a commit the jsDelivr and raw mirrors 404 on, forever).
!places/dist/
# node_modules may be a symlink in a worktree.
node_modules
